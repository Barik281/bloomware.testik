local function executeAutoMojo()
    if autoMojoRunning then
        return
    end
    autoMojoRunning = true
    farmLoopRunning = false

    addLog("AutoMojo: Level 100 reached! Starting rebirth process...", Color3.fromRGB(0, 255, 255))

    task.spawn(function()
        if packets.Rebirth and packets.Rebirth.send then
            packets.Rebirth.send()
            addLog("AutoMojo: Rebirth executed", Color3.fromRGB(0, 255, 0))
            task.wait(2)
        else
            addLog("AutoMojo: ERROR: Rebirth packet not found!", Color3.fromRGB(255, 0, 0))
            autoMojoRunning = false
            return
        end

        local rs = ReplicatedStorage
        if rs:FindFirstChild("Events") then
            local spawnEvent = rs.Events:FindFirstChild("SpawnFirst")
            if spawnEvent then
                spawnEvent:InvokeServer(false)
                task.spawn(function()
                    local character = plr.Character or plr.CharacterAdded:Wait()
                    task.wait(0.3)

                    local camera = workspace.CurrentCamera
                    if camera then
                        local humanoid = character:FindFirstChildOfClass("Humanoid")
                        local rootPart = character:FindFirstChild("HumanoidRootPart")

                        if humanoid and rootPart then
                            camera.CameraType = Enum.CameraType.Custom
                            camera.FieldOfView = 70
                            camera.CameraSubject = humanoid
                            camera.CFrame = rootPart.CFrame * CFrame.new(0, 2, 10) * CFrame.Angles(math.rad(-10), 0, 0)

                            task.wait(0.2)
                            camera.CameraSubject = nil
                            task.wait(0.05)
                            camera.CameraSubject = humanoid

                            if plr.Character then
                                plr.Character:FindFirstChildOfClass("Humanoid").CameraOffset = Vector3.new(0, 0, 0)
                            end
                        end
                    end

                    task.wait(0.2)
                    local playerGui = plr:FindFirstChild("PlayerGui")
                    if playerGui then
                        for _, gui in ipairs(playerGui:GetChildren()) do
                            if gui:IsA("ScreenGui") then
                                local name = gui.Name:lower()
                                if name:find("spawn") or name:find("select") or (name:find("menu") and (name:find("select") or name:find("spawn"))) then
                                    gui.Enabled = false
                                end
                            end
                        end

                        local mainGui = playerGui:FindFirstChild("MainGui")
                        if mainGui then
                            if mainGui:IsA("ScreenGui") then
                                mainGui.Enabled = true
                            elseif mainGui:IsA("Folder") or mainGui:IsA("Frame") then
                                local parent = mainGui.Parent
                                if parent and parent:IsA("ScreenGui") then
                                    parent.Enabled = true
                                end
                            end
                        end
                    end

                    task.wait(0.1)
                    if character:FindFirstChild("HumanoidRootPart") then
                        local humanoid = character:FindFirstChildOfClass("Humanoid")
                        if humanoid then
                            camera.CameraSubject = nil
                            task.wait(0.05)
                            camera.CameraSubject = humanoid
