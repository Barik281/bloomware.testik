local function getLevelProgress()
    local success, progress = pcall(function()
        local topbar = plr.PlayerGui:FindFirstChild("Topbar")
        if topbar then
            local topbarInner = topbar:FindFirstChild("Topbar")
            if topbarInner then
                local right = topbarInner:FindFirstChild("Right")
                if right then
                    local level = right:FindFirstChild("Level")
                    if level then
                        for _, child in ipairs(level:GetDescendants()) do
                            if child:IsA("Frame") or child:IsA("ImageLabel") then
                                local sizeX = child.Size.X
                                if sizeX.Scale > 0.01 and sizeX.Scale <= 1 then
                                    local parentName = (child.Parent and child.Parent.Name:lower()) or ""
                                    local childName = child.Name:lower()
                                    if parentName:find("progress") or parentName:find("bar") or parentName:find("fill") or 
                                       childName:find("progress") or childName:find("bar") or childName:find("fill") then
                                        return math.clamp(sizeX.Scale, 0, 1)
                                    end
                                end
                            end
                        end

                        local progressBar = level:FindFirstChild("ProgressBar") or level:FindFirstChild("Slider") or 
                                          level:FindFirstChild("Progress") or level:FindFirstChild("Bar") or
                                          level:FindFirstChild("Fill")
                        if progressBar then
                            for _, fill in ipairs(progressBar:GetDescendants()) do
                                if fill:IsA("Frame") or fill:IsA("ImageLabel") then
                                    local fillSize = fill.Size.X
                                    if fillSize.Scale > 0.01 and fillSize.Scale <= 1 then
                                        return math.clamp(fillSize.Scale, 0, 1)
                                    end
                                end
                            end

                            local fill = progressBar:FindFirstChild("Fill") or progressBar:FindFirstChild("Bar") or 
                                        progressBar:FindFirstChildOfClass("Frame")
                            if fill then
                                local fillSize = fill.Size.X
                                if fillSize.Scale > 0.01 then
                                    return math.clamp(fillSize.Scale, 0, 1)
                                end
                            end
                        end
                    end
                end
            end
        end
        return 0
    end)
    return success and progress or 0
end

