local function getPlayerLevel()
    local success, result = pcall(function()
        local topbar = plr.PlayerGui:FindFirstChild("Topbar")
        if topbar then
            local topbarInner = topbar:FindFirstChild("Topbar")
            if topbarInner then
                local right = topbarInner:FindFirstChild("Right")
                if right then
                    local level = right:FindFirstChild("Level")
                    if level then
                        local levelText = level:FindFirstChild("Level")
                        if levelText then
                            local levelStr = levelText.Text
                            local levelNum = levelStr:match("%d+")
                            return levelNum and tonumber(levelNum) or 0
                        end
                    end
                end
            end
        end
        return 0
    end)
    return success and result or 0
end

