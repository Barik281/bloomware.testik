    logLabel.Parent = scrollFrame

    if updatable then
        lastUpdatableLog = logLabel
    end

    local textSize = game:GetService("TextService"):GetTextSize(
        logLabel.Text,
        logLabel.TextSize,
        logLabel.Font,
        Vector2.new(scrollFrame.AbsoluteSize.X - 12, math.huge)
