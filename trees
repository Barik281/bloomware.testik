local function findAncientTree()
    local trees = {}

    if workspace:FindFirstChild("Resources") then
        for _, resource in ipairs(workspace.Resources:GetChildren()) do
            if resource:IsA("Model") then
                local name = resource.Name:lower()
                if name:find("ancient") and name:find("tree") then
                    local entityID = resource:GetAttribute("EntityID")
                    local primaryPart = resource.PrimaryPart or resource:FindFirstChildWhichIsA("BasePart")
                    if entityID and primaryPart then
                        table.insert(trees, {
                            Model = resource,
                            Position = primaryPart.Position,
                            EntityID = entityID
                        })
                    end
                end
            end
        end
    end

    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") then
            local name = obj.Name:lower()
            if name:find("ancient") and name:find("tree") then
                local entityID = obj:GetAttribute("EntityID")
                local primaryPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                if entityID and primaryPart then
                    table.insert(trees, {
                        Model = obj,
                        Position = primaryPart.Position,
                        EntityID = entityID
                    })
                end
            end
        end
    end

    if #trees > 0 and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
        local rootPart = plr.Character.HumanoidRootPart
        table.sort(trees, function(a, b)
            return (a.Position - rootPart.Position).Magnitude < (b.Position - rootPart.Position).Magnitude
        end)
    end

    return trees
end

local function moveToPosition(targetPosition, distanceThreshold)
    distanceThreshold = distanceThreshold or 5
    local character = plr.Character
    if not character then return false end

    local humanoid = character:FindFirstChild("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not rootPart then return false end

    local distance = (rootPart.Position - targetPosition).Magnitude
    if distance <= distanceThreshold then
        return true
    end

    humanoid:MoveTo(targetPosition)

    local startTime = tick()
    while tick() - startTime < 30 do
        if not humanoid or not rootPart then break end

        distance = (rootPart.Position - targetPosition).Magnitude
        if distance <= distanceThreshold then
            return true
        end

        humanoid:MoveTo(targetPosition)
        task.wait(0.1)
    end

    return distance <= distanceThreshold
end

local function breakTree(entityID)
    if not packets.SwingTool or not packets.SwingTool.send then
        return false
    end

    local char = plr.Character
    if not char then return false end

    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local success = false
    pcall(function()
        packets.SwingTool.send({
            entityIDs = {
                { entityID = entityID, buffer = 0 }
            },
            cframe = root.CFrame,
            timestamp = tick()
        })
        success = true
    end)

    return success
end

local collectedEssenceIDs = {}

local function collectEssence()
    local collected = 0

    local itemsFolder = workspace:FindFirstChild("Items")
    if not itemsFolder then
        return collected
    end

    if not packets.Pickup or not packets.Pickup.send then
        return collected
    end

    for _, item in ipairs(itemsFolder:GetChildren()) do
        if item:IsA("BasePart") or item:IsA("MeshPart") or item:IsA("Model") then
            local itemName = item.Name:lower()

            if itemName:find("essence") or itemName:find("void essence") or itemName:find("soul") then
                local entityID = item:GetAttribute("EntityID") or item:GetAttribute("NetID") or item:GetAttribute("Id")

                if entityID and not collectedEssenceIDs[entityID] then
                    local success = false
                    pcall(function()
                        if packets.Pickup.send then
                            packets.Pickup.send(entityID)
                            success = true
                        end
                    end)

                    if not success then
                        pcall(function()
                            if packets.Pickup.send then
                                packets.Pickup.send({ value = entityID })
                                success = true
                            end
                        end)
                    end

                    if not success then
                        pcall(function()
                            if packets.Pickup.send then
                                packets.Pickup.send({ entityID = entityID })
                                success = true
                            end
                        end)
                    end

                    if success then
                        collectedEssenceIDs[entityID] = true
                        collected = collected + 1
                    end
                end
            end
        end
    end

    return collected
end

local function spawnOnBed()
    local currentTime = tick()
    local timeSinceJoin = currentTime - joinTime
    local timeSinceSpawn = currentTime - lastSpawnTime
    local remainingFromJoin = math.max(0, spawnCooldown - timeSinceJoin)
    local remainingFromSpawn = math.max(0, spawnCooldown - timeSinceSpawn)
    local remainingTime = math.max(remainingFromJoin, remainingFromSpawn)

    if remainingTime > 0 then
        addLog("Cooldown: " .. math.ceil(remainingTime) .. "s", Color3.fromRGB(255, 165, 0))
        return false
    end

    local events = ReplicatedStorage:FindFirstChild("Events")
    if not events then
        addLog("Events not found!", Color3.fromRGB(255, 0, 0))
        return false
    end

    local success = false
    local spawnFirst = events:FindFirstChild("SpawnFirst")

    if spawnFirst then
        pcall(function()
            if spawnFirst:IsA("RemoteFunction") then
                spawnFirst:InvokeServer(true)
                success = true
            elseif spawnFirst:IsA("RemoteEvent") then
                spawnFirst:FireServer(true)
                success = true
            end
        end)
    end

    if not success then
        local spawnTouch = events:FindFirstChild("SpawnTouch")
        if spawnTouch then
            pcall(function()
                if spawnTouch:IsA("RemoteFunction") then
                    spawnTouch:InvokeServer(true)
                    success = true
                elseif spawnTouch:IsA("RemoteEvent") then
                    spawnTouch:FireServer(true)
                    success = true
                end
            end)
        end
    end

    if success then
        lastSpawnTime = tick()
        addLog("Bed spawn requested!", Color3.fromRGB(0, 255, 0))

        task.spawn(function()
            local character = plr.Character or plr.CharacterAdded:Wait()

            local maxWait = 5
            local waitTime = 0
            while waitTime < maxWait do
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                if humanoid and rootPart and humanoid.Health > 0 then
                    break
                end
                task.wait(0.1)
                waitTime = waitTime + 0.1
            end

            task.wait(1.5)
            addLog("Character fully loaded!", Color3.fromRGB(0, 255, 0))

            local camera = workspace.CurrentCamera
            if camera and character then
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    camera.CameraSubject = humanoid
                    camera.CameraType = Enum.CameraType.Custom
                    plr.CameraMode = Enum.CameraMode.Classic
                end
            end
        end)

        task.wait(2)

    else
        addLog("Failed to spawn on bed!", Color3.fromRGB(255, 0, 0))
    end

    return success
end

