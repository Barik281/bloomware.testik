local function updateStat(moduleName, value, status, progress)
    local module = statsContainer:FindFirstChild(moduleName .. "Module")
    if module then
        local valueLabel = module:FindFirstChild("Value")
        if valueLabel then
            valueLabel.Text = tostring(value)
        end

        if status ~= nil then
            local statusIndicator = module:FindFirstChild("StatusIndicator")
            if statusIndicator then
                statusIndicator.BackgroundColor3 = status and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 100, 100)
            end
        end

        if progress ~= nil then
            local progressBarContainer = module:FindFirstChild("ProgressBarContainer")
            if progressBarContainer then
                local segmentCount = 20
                progress = math.clamp(progress, 0, 1)
                local filledSegments = math.floor(progress * segmentCount + 0.5)
                filledSegments = math.min(segmentCount, math.max(0, filledSegments))

                for i = 1, segmentCount do
                    local segment = progressBarContainer:FindFirstChild("Segment" .. i)
                    if segment then
                        if i <= filledSegments then
                            segment.BackgroundColor3 = Color3.fromRGB(150, 100, 255)
                        else
                            segment.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
                        end
                    end
                end
            end
        end
    end
end

local lastUpdatableLog = nil

local function addLog(message, color, updatable)
    color = color or Color3.fromRGB(200, 200, 200)
    updatable = updatable or false

    if updatable and lastUpdatableLog and lastUpdatableLog.Parent then
        lastUpdatableLog.Text = "[" .. os.date("%H:%M:%S") .. "] " .. message
        lastUpdatableLog.TextColor3 = color

        local textSize = game:GetService("TextService"):GetTextSize(
            lastUpdatableLog.Text,
            lastUpdatableLog.TextSize,
            lastUpdatableLog.Font,
            Vector2.new(scrollFrame.AbsoluteSize.X - 12, math.huge)
        )
        lastUpdatableLog.Size = UDim2.new(1, -6, 0, math.max(15, textSize.Y + 2))

        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 10)
        scrollFrame.CanvasPosition = Vector2.new(0, scrollFrame.AbsoluteCanvasSize.Y)

        return
