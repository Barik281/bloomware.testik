local function farmLoop()
    if farmLoopRunning then
        addLog("Farm loop already running!", Color3.fromRGB(255, 165, 0))
        return
    end
    farmLoopRunning = true

    addLog("Starting farm cycle...", Color3.fromRGB(0, 255, 255))

    if config.autoMojo and (autoMojoRunning or getPlayerLevel() >= 100) then
        addLog("Level 100 detected. Switching to AutoMojo...", Color3.fromRGB(0, 255, 255))
        if not autoMojoRunning then
            executeAutoMojo()
        end
        farmLoopRunning = false
        return
    end

    addLog("Checking for bed...", Color3.fromRGB(200, 200, 200))
    local beds = checkMyBed()
    if #beds == 0 then
        addLog("ERROR: No bed found! UserId: " .. tostring(myUserId), Color3.fromRGB(255, 0, 0))
        addLog("Waiting 10 seconds before retry...", Color3.fromRGB(255, 165, 0))
        farmLoopRunning = false
        task.wait(10)
        return farmLoop()
    end
    addLog("Bed found!", Color3.fromRGB(0, 255, 0))

    addLog("Waiting 130 seconds...", Color3.fromRGB(200, 200, 200))
    clearUpdatableLog()
    local waitStartTime = tick()
    while tick() - waitStartTime < 130 do
        local elapsed = math.floor(tick() - waitStartTime)
        local remaining = 130 - elapsed

        addLog("Waiting: " .. remaining .. "s remaining", Color3.fromRGB(150, 150, 150), true)

        if config.autoMojo and (autoMojoRunning or getPlayerLevel() >= 100) then
            clearUpdatableLog()
            addLog("Level 100 reached during wait. Switching to AutoMojo...", Color3.fromRGB(0, 255, 255))
            if not autoMojoRunning then
                executeAutoMojo()
            end
            farmLoopRunning = false
            return
        end

        task.wait(1)
    end
    clearUpdatableLog()
    addLog("Wait complete!", Color3.fromRGB(0, 255, 0))

    addLog("Spawning on bed...", Color3.fromRGB(200, 200, 200))
    if spawnOnBed() then
        addLog("Spawned on bed successfully", Color3.fromRGB(0, 255, 0))

        addLog("Waiting for character to fully load...", Color3.fromRGB(200, 200, 200))

        local char = plr.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")

            local waitTime = 0
            while waitTime < 5 do
                if root and hum and hum.Health > 0 then
                    break
                end
                task.wait(0.1)
                waitTime = waitTime + 0.1
                root = char:FindFirstChild("HumanoidRootPart")
                hum = char:FindFirstChildOfClass("Humanoid")
            end
        end

        task.wait(1.5)
        addLog("Character ready!", Color3.fromRGB(0, 255, 0))

        task.wait(1)
        smartBuyCraftAndEquip()

    else
        addLog("Failed to spawn on bed", Color3.fromRGB(255, 0, 0))
        task.wait(2)
    end

    local character = plr.Character
    if not character then
        character = plr.CharacterAdded:Wait()
    end
    character:WaitForChild("HumanoidRootPart")
    character:WaitForChild("Humanoid")
    task.wait(1)

    -- ============================================
    -- ПРОВЕРКА: ЕСЛИ GOD AXE В РУКАХ — НЕ ПЕРЕБИВАЕМ
    -- ============================================
    local currentTool = getToolInHands()
    local hasGodAxe = false
    
    if currentTool then
        if currentTool == "God Axe" or currentTool == "GodAxe" or currentTool == "God_Axe" or
           (currentTool:lower():find("god") and currentTool:lower():find("axe")) then
            hasGodAxe = true
            addLog("✅ God Axe уже в руках! Пропускаю экипировку слота 2.", Color3.fromRGB(0, 255, 0))
        end
    end

    -- ТОЛЬКО ЕСЛИ GOD AXE НЕТ — ЭКИПИРУЕМ СЛОТ 2
    if not hasGodAxe then
        addLog("Selecting slot 2", Color3.fromRGB(200, 200, 200))
        if packets.EquipTool and packets.EquipTool.send then
            packets.EquipTool.send(2)
            addLog("Slot 2 selected", Color3.fromRGB(0, 255, 0))
            task.wait(0.5)
        else
            addLog("Failed to select slot 2", Color3.fromRGB(255, 0, 0))
        end
    end

    addLog("Searching for Ancient Tree...", Color3.fromRGB(200, 200, 200))
    local trees = findAncientTree()
    if #trees == 0 then
        addLog("ERROR: No Ancient Tree found!", Color3.fromRGB(255, 0, 0))
        addLog("Rejoining server...", Color3.fromRGB(255, 165, 0))
        task.wait(2)
        rejoinServer()
        return
    end

    local targetTree = trees[1]

    addLog("Moving to Ancient Tree...", Color3.fromRGB(200, 200, 200))
    if moveToPosition(targetTree.Position, 10) then
        addLog("Reached Ancient Tree", Color3.fromRGB(0, 255, 0))
    else
        addLog("Failed to reach Ancient Tree", Color3.fromRGB(255, 0, 0))
        addLog("Rejoining server...", Color3.fromRGB(255, 165, 0))
        task.wait(2)
        rejoinServer()
        return
    end

    addLog("Breaking Ancient Tree...", Color3.fromRGB(200, 200, 200))
    clearUpdatableLog()
    local breakStartTime = tick()
    local breakTimeout = 420
    local treeBroken = false
    local lastLogUpdate = 0

    while tick() - breakStartTime < breakTimeout do
        local treeExists = false
        if workspace:FindFirstChild("Resources") then
            for _, resource in ipairs(workspace.Resources:GetChildren()) do
                if resource:IsA("Model") and resource:GetAttribute("EntityID") == targetTree.EntityID then
                    treeExists = true
                    break
                end
            end
        end

        if not treeExists then
            clearUpdatableLog()
            addLog("Tree destroyed!", Color3.fromRGB(0, 255, 0))
            treeBroken = true
            break
        end

        breakTree(targetTree.EntityID)

        local currentTime = tick()
        if currentTime - lastLogUpdate >= 1 then
            local elapsed = math.floor(currentTime - breakStartTime)
            addLog("Breaking tree... " .. elapsed .. "s", Color3.fromRGB(200, 200, 200), true)
            lastLogUpdate = currentTime
        end

        task.wait(0.1)
    end

    clearUpdatableLog()
    if not treeBroken then
        addLog("Tree breaking timeout after " .. breakTimeout .. " seconds", Color3.fromRGB(255, 165, 0))
    end

    addLog("Collecting Essence...", Color3.fromRGB(200, 200, 200))
    task.wait(0.5)

    collectedEssenceIDs = {}
    local totalCollected = 0
    local collectEndTime = tick() + 2

    while tick() < collectEndTime do
        local collected = collectEssence()
        totalCollected = totalCollected + collected
        task.wait(0.01)
    end

    addLog("Essence collection complete", Color3.fromRGB(0, 255, 0))

    if config.autoMojo and (autoMojoRunning or getPlayerLevel() >= 100) then
        addLog("AutoMojo in progress. Skipping farm rejoin.", Color3.fromRGB(0, 255, 255))
        farmLoopRunning = false
        return
    end

    addLog("Cycle complete! Rejoining server...", Color3.fromRGB(200, 200, 200))
    task.wait(2)

    farmLoopRunning = false
    rejoinServer()

    addLog("Rejoin initiated. Script will auto-restart after rejoin.", Color3.fromRGB(0, 255, 255))
end

